{
  "name": "kotlin-interview-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:ci": "vitest run --run src/engine/mastery.test.ts",
    "verify": "npm run test:ci && npm run build",
    "auto-approve-tests": "npm run verify",
    "ai-auto-approve-tests": "npm run verify",
    "export:solutions": "npx vite-node scripts/export-solution-json.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
